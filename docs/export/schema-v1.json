{
  "$defs": {
    "ExportAccount": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "login": {
          "title": "Login",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "login",
        "created_at"
      ],
      "title": "ExportAccount",
      "type": "object"
    },
    "ExportEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Occurred At",
          "type": "string"
        },
        "glucose": {
          "anyOf": [
            {
              "pattern": "^[0-9]+\\.[0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Glucose"
        },
        "bolus": {
          "pattern": "^[0-9]+\\.[0-9]$",
          "title": "Bolus",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "food",
                "correction",
                "food_and_correction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "comment": {
          "title": "Comment",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Updated At",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "deleted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deleted At"
        }
      },
      "required": [
        "id",
        "occurred_at",
        "glucose",
        "bolus",
        "reason",
        "comment",
        "created_at",
        "updated_at",
        "revision",
        "deleted_at"
      ],
      "title": "ExportEntry",
      "type": "object"
    },
    "ExportSettings": {
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "const": "Europe/Moscow",
          "default": "Europe/Moscow",
          "title": "Timezone",
          "type": "string"
        },
        "theme": {
          "const": "dark",
          "default": "dark",
          "title": "Theme",
          "type": "string"
        }
      },
      "title": "ExportSettings",
      "type": "object",
      "required": [
        "timezone",
        "theme"
      ]
    },
    "ExportTemporary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Starts At",
          "type": "string"
        },
        "ends_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Ends At",
          "type": "string"
        },
        "effective_ends_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective Ends At"
        },
        "duration_minutes": {
          "title": "Duration Minutes",
          "type": "integer"
        },
        "percent": {
          "title": "Percent",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "title": "Updated At",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "deleted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deleted At"
        }
      },
      "required": [
        "id",
        "starts_at",
        "ends_at",
        "effective_ends_at",
        "duration_minutes",
        "percent",
        "created_at",
        "updated_at",
        "revision",
        "deleted_at"
      ],
      "title": "ExportTemporary",
      "type": "object"
    },
    "ExportUnits": {
      "additionalProperties": false,
      "properties": {
        "timestamps": {
          "const": "RFC 3339 UTC, milliseconds",
          "default": "RFC 3339 UTC, milliseconds",
          "title": "Timestamps",
          "type": "string"
        },
        "glucose": {
          "const": "mmol/L",
          "default": "mmol/L",
          "title": "Glucose",
          "type": "string"
        },
        "bolus": {
          "const": "U",
          "default": "U",
          "title": "Bolus",
          "type": "string"
        },
        "rate": {
          "const": "U/h",
          "default": "U/h",
          "title": "Rate",
          "type": "string"
        },
        "duration_minutes": {
          "const": "minute",
          "default": "minute",
          "title": "Duration Minutes",
          "type": "string"
        },
        "percent": {
          "const": "percent",
          "default": "percent",
          "title": "Percent",
          "type": "string"
        },
        "minute": {
          "const": "minute of Moscow day",
          "default": "minute of Moscow day",
          "title": "Minute",
          "type": "string"
        }
      },
      "title": "ExportUnits",
      "type": "object",
      "required": [
        "timestamps",
        "glucose",
        "bolus",
        "rate",
        "duration_minutes",
        "percent",
        "minute"
      ]
    },
    "IntervalInput": {
      "additionalProperties": false,
      "properties": {
        "minute": {
          "description": "Минута от московской полуночи",
          "maximum": 1439,
          "minimum": 0,
          "title": "Minute",
          "type": "integer"
        },
        "rate": {
          "description": "От 0 до 21474836.47 ед/ч; сотые, точка или запятая; завершающие нули допустимы",
          "maxLength": 10000,
          "title": "Rate",
          "type": "string"
        }
      },
      "required": [
        "minute",
        "rate"
      ],
      "title": "IntervalInput",
      "type": "object"
    },
    "ScheduleOutput": {
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "ends_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "format": "date-time",
          "title": "Ends At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "intervals": {
          "items": {
            "$ref": "#/$defs/IntervalInput"
          },
          "title": "Intervals",
          "type": "array"
        }
      },
      "required": [
        "id",
        "starts_at",
        "ends_at",
        "created_at",
        "intervals"
      ],
      "title": "ScheduleOutput",
      "type": "object",
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "exported_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "title": "Exported At",
      "type": "string"
    },
    "timezone": {
      "const": "Europe/Moscow",
      "default": "Europe/Moscow",
      "title": "Timezone",
      "type": "string"
    },
    "units": {
      "$ref": "#/$defs/ExportUnits",
      "default": {
        "timestamps": "RFC 3339 UTC, milliseconds",
        "glucose": "mmol/L",
        "bolus": "U",
        "rate": "U/h",
        "duration_minutes": "minute",
        "percent": "percent",
        "minute": "minute of Moscow day"
      }
    },
    "settings": {
      "$ref": "#/$defs/ExportSettings",
      "default": {
        "timezone": "Europe/Moscow",
        "theme": "dark"
      }
    },
    "account": {
      "$ref": "#/$defs/ExportAccount"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ExportEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "basal_schedules": {
      "items": {
        "$ref": "#/$defs/ScheduleOutput"
      },
      "title": "Basal Schedules",
      "type": "array"
    },
    "temporary_basals": {
      "items": {
        "$ref": "#/$defs/ExportTemporary"
      },
      "title": "Temporary Basals",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "exported_at",
    "timezone",
    "units",
    "settings",
    "account",
    "entries",
    "basal_schedules",
    "temporary_basals"
  ],
  "title": "FullExport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
